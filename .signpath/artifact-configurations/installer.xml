<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "installer": signs the NSIS installer, which already contains
  the exe signed with "app-exe". SignPath can't look inside NSIS installers, so the exe is signed
  in a separate request first.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file
      path="ScreenPrompt_${version}_x64-setup.exe"
      product-name="ScreenPrompt"
      product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
